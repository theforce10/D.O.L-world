# Supabase → Project Settings → API (or Connect). The anon / publishable key is safe in the browser.
# NEVER put the service_role / secret key in any VITE_ variable — it would ship to every visitor.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Shown in the consent text, titles and emails.
VITE_EVENT_BRAND=DOL World

# Shown on /privacy and /terms for data and deletion requests.
VITE_CONTACT_EMAIL=mixandminglelagos01@gmail.com
